# Turn-taking overrides for the production worker (2026-09-24).
#
# Loaded by a systemd drop-in AFTER /etc/sakhi.env (which is rewritten from
# Secrets Manager on every boot), so these win without editing the secret.
# Remove /etc/systemd/system/sakhi-agent.service.d/10-turn-tuning.conf and
# restart sakhi-agent to return to the secret's values.
#
# Why: the secret carried VAD_MIN_SILENCE=0.30 + MIN_ENDPOINTING_DELAY=0.20,
# a 0.50s commit window - below the 0.75-1.2s band that
# tests/test_conversation_feel.py::test_endpointing_window_gives_room_to_breathe
# sets for spoken Kannada. Live logs (2026-09-22) show one answer split into
# two committed turns ~1.4s apart, each getting its own reply: the same
# question asked twice. 0.45 + 0.35 = 0.80s is the smallest window inside
# that band.
VAD_MIN_SILENCE=0.45
MIN_ENDPOINTING_DELAY=0.35
# Recall/spelling turns (names, dates) must get at least the normal window.
VAD_ENDPOINT_SLOW_S=1.0
# Speculative replies were generated before her answer was recorded and then
# spoken - see preemptive_generation_enabled() in agent.py.
PREEMPTIVE_GENERATION=false
