{
  "rewrites": [
    { "source": "/", "destination": "/frontend/local_preview.html" },
    { "source": "/api/token", "destination": "/api/index" },
    { "source": "/api/logs", "destination": "/api/index" },
    { "source": "/api/worker-status", "destination": "/api/index" },
    { "source": "/api/tts-catalog", "destination": "/api/index" },
    { "source": "/api/sakhi/:path*", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{voice_catalog.py,vercel_common.py,sakhi_gateway.py,sakhi_live/**}"
    }
  }
}
