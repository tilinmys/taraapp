  "description": "Sakhi (Tara): an open-source Kannada/Hindi voice agent that helps ASHA workers screen pregnant women for pre-eclampsia and other danger signs (SDG 3.1 and 3.2). Repo-root shortcuts; the projects live in app/ (tara app), mobile/ and frontend/ (web dashboard).",
  "keywords": [
    "digital-public-good",
    "unicef-venture-fund",
    "maternal-health",
    "asha-worker",
    "voice-agent",
    "pre-eclampsia",
    "indic-nlp",
    "kannada",
    "hindi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tilinmys/taraapp.git"
  },
  "scripts": {
    "start": "npm --prefix app run start",
    "lan": "npm --prefix app run lan",
    "tunnel": "npm --prefix app run tunnel",
    "web": "npm --prefix app run web",
    "lint": "npm --prefix app run lint",
    "typecheck": "npm --prefix app run typecheck",
    "app:install": "npm --prefix app install"
  }
}
