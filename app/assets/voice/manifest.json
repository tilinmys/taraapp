    "ms": 1280,
    "bytes": 41004,
    "hash": "198889f7a8a4"
   },
   "ask_age": {
    "text": "माता की उम्र कितनी है?",
    "file": "hi/ask_age.wav",
    "ms": 1440,
    "bytes": 46124,
    "hash": "6d2bde0bb30d"
   },
   "ask_diastolic": {
    "text": "बीपी का नीचे वाला नंबर कितना है?",
