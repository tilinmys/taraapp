  "hi": {
   "greeting": {
    "text": "नमस्ते! मैं सखी हूँ। मैं माँ के बारे में 24 सवाल पूछूंगी। हर सवाल का जवाब ज़ोर से दें।",
    "file": "hi/greeting.wav",
    "ms": 5280,
    "bytes": 169004,
    "hash": "6bfc356a6474"
   },
   "reask": {
    "text": "माफ़ कीजिए, ठीक से समझ नहीं आया। मैं फिर से पूछती हूँ।",
    "file": "hi/reask.wav",
    "ms": 3200,
    "bytes": 102444,
    "hash": "3b04c6efd92f"
   },
   "reprompt": {
    "text": "जवाब सुनाई नहीं दिया। कृपया एक बार फिर बोलें।",
    "file": "hi/reprompt.wav",
    "ms": 2560,
    "bytes": 81964,
    "hash": "c0ff93b7ca38"
   },
   "ask_name": {
    "text": "माता का नाम क्या है?",
