    "ms": 1920,
    "bytes": 61484,
    "hash": "459a97f06a02"
   },
   "ask_para": {
    "text": "पहले कितने बच्चे जन्मे हैं?",
    "file": "hi/ask_para.wav",
    "ms": 1600,
    "bytes": 51244,
    "hash": "e752838c6ad7"
   },
   "ask_allergy": {
    "text": "किसी दवाई से एलर्जी है क्या?",
