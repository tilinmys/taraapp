    "ms": 1600,
    "bytes": 51244,
    "hash": "aa32d8d56db4"
   },
   "waiting": {
    "text": "आराम से बताइए। मैं सुन रही हूँ।",
    "file": "hi/waiting.wav",
    "ms": 2240,
    "bytes": 71724,
    "hash": "2ed37616ba99"
   },
   "away": {
    "text": "कोई आवाज़ सुनाई नहीं दे रही। मैं रुकती हूँ। तैयार हों तो आगे बढ़ें दबाइए।",
